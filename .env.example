# Juno source runtime example.
# Copy to .env and adjust paths for your machine.

# Core runtime
JUNO_V2_MODE=live
JUNO_V2_SUPPORTED_LANGUAGES=en,zh,es,ja,hi,ko,fr,de,pt,ar,th,id
JUNO_V2_LANGUAGE_POLICY=auto_supported
JUNO_V2_SPEECH_PROFILE=standard

# Portable defaults. The Mac launcher scripts override these with the
# Apple Silicon local model lanes when you run the full app stack.
JUNO_V2_PREVIEW_BACKEND=faster_whisper
JUNO_V2_FINAL_BACKEND=faster_whisper
JUNO_V2_PREVIEW_MODEL_PATH=.juno_v2_demo/models/preview
JUNO_V2_FINAL_MODEL_PATH=.juno_v2_demo/models/final
JUNO_V2_PREVIEW_ENDPOINT=
JUNO_V2_FINAL_ENDPOINT=

# Optional writer backend. Leave empty for built-in deterministic writing.
JUNO_V2_WRITER_BACKEND=
JUNO_V2_WRITER_MODEL_PATH=
JUNO_V2_WRITER_ENDPOINT=
JUNO_V2_WRITER_MAX_TOKENS=192
JUNO_V2_WRITER_TEMPERATURE=0.0
JUNO_V2_WRITER_TOP_P=1.0

# Context/insertion
JUNO_V2_CONTEXT_SOURCE=static
JUNO_V2_CONTEXT_HELPER_COMMAND=
JUNO_V2_INSERTION_TARGET=none
JUNO_V2_INSERTION_HELPER_COMMAND=

# Runtime artifacts
JUNO_V2_RUNTIME_DIR=.juno_v2_runtime
JUNO_V2_LOG_DIR=.juno_v2_logs/service
JUNO_V2_MEMORY_DIR=.juno_v2_memory

# Model residency controls. These are meaningful for local model lanes.
JUNO_V2_GPU_MEMORY_BUDGET_MB=
JUNO_V2_PREVIEW_GPU_MEMORY_MB=0
JUNO_V2_FINAL_GPU_MEMORY_MB=0
JUNO_V2_WRITER_GPU_MEMORY_MB=0
JUNO_V2_PREVIEW_RESIDENCY_POLICY=resident
JUNO_V2_FINAL_RESIDENCY_POLICY=resident
JUNO_V2_WRITER_RESIDENCY_POLICY=resident

# Development signing. Example keys are ignored unless explicitly enabled.
JUNO_KEYSTORE=
JUNO_ALLOW_EXAMPLE_KEYSTORE=0
