---
config:
  theme: base
  themeVariables:
    primaryColor: '#f0f4ff'
    primaryTextColor: '#1a1a2e'
    primaryBorderColor: '#4a6cf7'
    lineColor: '#4a6cf7'
    secondaryColor: '#fff8f0'
    tertiaryColor: '#f0fff4'
---
flowchart TD
    MIC["🎙️ Microphone\naudio"] --> ENGINE

    CTX["📄 Selected text\nCurrent app / field\nApp & window title"] --> ENGINE

    CLIP["📋 Recent clipboard\n(opt-in, off by default)"] --> ENGINE

    ENGINE["🔒 Local Voice Engine\nAll processing on this Mac\nNothing sent to cloud"]

    ENGINE --> INSERT["✅ Inserted into\ntarget app"]
    ENGINE --> COPYREADY["📋 Copy Ready\n(insertion blocked)"]
    ENGINE --> HISTORY["📂 Local history\n(SQLite, this Mac)"]
    ENGINE --> AUDIO["🎵 Audio recording\n(opt-in retention)"]
    ENGINE --> LEARN["🧠 Correction learning\n(local memory)"]

    SECURE["🔐 Secure / password field"] -->|"Blocks everything:\ncapture · context · history\nlearning · audio · paste"| ENGINE

    style SECURE fill:#fff0f0,stroke:#e53e3e,color:#c53030
    style CLIP fill:#fff8f0,stroke:#dd6b20
    style ENGINE fill:#ebf8ff,stroke:#3182ce
