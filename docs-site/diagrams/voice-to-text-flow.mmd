flowchart LR
    SHORTCUT["⌨️ Press shortcut\nFn / Globe key"] --> HUD

    HUD["🔵 HUD appears\nWaiting for speech…\nListening…\nPolishing…"] --> ENGINE

    ENGINE["🔒 Local voice engine\nASR → Writer → ITN\nAll on this Mac"] --> RESULT

    RESULT{{"Result ready?"}}

    RESULT -->|"Target field\naccepts text"| INSERT["✅ Inserted\nText placed at cursor"]
    RESULT -->|"Field blocked\nor unsafe"| COPY["📋 Copy Ready\nText on clipboard"]

    INSERT --> HIST["📂 History\nSaved locally"]
    COPY --> HIST
